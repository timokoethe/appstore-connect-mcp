{
  "name": "appstoreconnect-mcp",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.0",
  "description": "A lightweight, read-only MCP server for Apple App Store Connect. Access apps, versions, metadata, TestFlight builds, and screenshots with Claude Code, Codex, and other MCP clients.",
  "main": "build/index.js",
  "bin": {
    "appstoreconnect-mcp": "build/index.js"
  },
  "files": ["build/", "docs/", "SECURITY.md"],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepack": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('build', { recursive: true, force: true });\" && npm run build",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:package": "node --test test/package-smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timokoethe/appstore-connect-mcp.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/timokoethe/appstore-connect-mcp/issues"
  },
  "homepage": "https://github.com/timokoethe/appstore-connect-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
